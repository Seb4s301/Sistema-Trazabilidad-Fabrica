# ============================================================================
# Latin Dream · ERP Trazabilidad Fábrica — Plantilla de variables de entorno
# ============================================================================
# Copia este archivo a .env y completa los valores con los de tu Supabase.
# .env.example SÍ se sube a git como referencia para el equipo.
# ============================================================================

# --- Base de datos PostgreSQL en Supabase ---
# Consigue estos valores en Supabase: Settings → Database → Connection string → URI
DB_URL=jdbc:postgresql://db.TU_PROYECTO.supabase.co:5432/postgres?sslmode=require
DB_USER=postgres
DB_PASSWORD=TU_CONTRASEÑA_DE_BASE_DE_DATOS

# --- Servidor backend (Spring Boot) ---
SERVER_PORT=8080
API_PREFIX=/api/v1

# --- CORS (orígenes permitidos para el frontend) ---
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# --- Seguridad JWT (cambia esta clave en producción) ---
JWT_SECRET=cambia_esta_clave_por_una_segura_en_produccion
JWT_EXPIRATION=86400000

# --- Zona horaria de operación (Perú) ---
TZ=America/Lima

# --- Semilla de usuarios de prueba (SOLO DESARROLLO) ---
APP_SEED_ENABLED=true
APP_SEED_PASSWORD=Latin2026!
